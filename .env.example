# Пример .env — только ключи и заглушки. Реальные значения кладём в .env (он в .gitignore).

# Django
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (в docker DATABASES_HOST=db)
DATABASES_NAME=ads_db
DATABASES_USER=ads_user
DATABASES_PASSWORD=change-me
DATABASES_HOST=localhost
DATABASES_PORT=5432

# Celery / Redis (в docker адрес подставляет docker-compose: redis://redis:6379/0)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Серверные ключи NovaGram (заголовок X-API-Key): выдача рекламы, показ/клик старых заказов, баннеры.
# Ключ зашит в приложение — при смене кладём новый и старый через запятую в AD_SERVER_API_KEYS,
# старый убираем, когда старых версий приложения не останется. AD_SERVER_API_KEY — как раньше,
# работает вместе со списком. Все пусто → эти эндпоинты закрыты
AD_SERVER_API_KEY=change-me
AD_SERVER_API_KEYS=

# Доля канала-площадки от цены показа (партнёрская программа)
PARTNER_SHARE_RATE=0.5

# Путь к сервисному JSON-ключу Firebase (push). Пусто → push выключен
FIREBASE_CREDENTIALS_FILE=

# Общий логин с AdGram: секрет, которым AdGram подписывает свои JWT (HS256).
# Пусто → вход через AdGram выключен.
# ВАЖНО: НЕ должен совпадать с SECRET_KEY — иначе приложение не стартует (ImproperlyConfigured)
ADGRAM_JWT_SECRET=

# Общий баланс с AdGram: адрес бэкенда AdGram и ключ его внутреннего API (заголовок X-Internal-Key).
# Пусто → юзеры AdGram не могут создавать заказы, возвраты копятся до появления настроек
ADGRAM_INTERNAL_URL=
ADGRAM_INTERNAL_KEY=

# Только на сервере, где AdGram на том же хосте: web и celery_worker подключаются к его docker-сети
# (ADGRAM_INTERNAL_URL=http://adgram-backend:4000). Локально не задавать
# COMPOSE_FILE=docker-compose.yml:docker-compose.adgram.yml
# ADGRAM_NETWORK=adgram_default

# Общий кэш (справочники, троттлинг). В docker-compose уже задан: redis://redis:6379/1.
# Пусто → память процесса (только для локальной разработки)
CACHE_REDIS_URL=

# Токен бота для Bot API: числовой id каналов по t.me-ссылке. Для прода обязателен
TELEGRAM_RESOLVER_BOT_TOKEN=

# Выдача объявлений v2: отдельный Redis (AOF + noeviction). В docker-compose адрес подставляется сам
ADS_REDIS_URL=redis://localhost:6379/2
# Секреты выдачи — длинные случайные и РАЗНЫЕ строки (openssl rand -hex 32). Пусто → выдача отвечает 503.
# VIEWER_HASH_SECRET без нужды не менять: сменятся viewer_key (счётчики частоты показов, жалобы).
# Смена ADS_TOKEN_SECRET обнуляет уже выданные random_id (события по ним в течение часа не засчитаются)
VIEWER_HASH_SECRET=
ADS_TOKEN_SECRET=
# Сколько клиент кэширует ответ выдачи, с; и пустой ответ, когда выдача недоступна
ADS_CACHE_TTL=300
ADS_EMPTY_TTL=60
# Срок жизни random_id, с
ADS_TOKEN_TTL=3600
# Лимиты запросов в минуту: на зрителя (выдача, события, жалобы — отдельно) и на IP. 0 — без лимита.
# На IP — общий счётчик serve/events/report и с большим запасом: у мобильных операторов CGNAT
ADS_RATE_VIEWER_SERVE=60
ADS_RATE_VIEWER_EVENTS=60
ADS_RATE_VIEWER_REPORTS=10
ADS_RATE_IP=60000
# Redis для тестов выдачи (python manage.py test). Эта база очищается перед каждым тестом!
ADS_REDIS_TEST_URL=redis://localhost:6379/15

# Сервис serving (docker-compose): горячий путь выдачи — свои ядра, воркеры и потоки gunicorn
SERVING_CPUS=8
SERVING_WORKERS=8
SERVING_THREADS=4
# Память Redis выдачи (redis_ads). При переполнении — отказ в записи (noeviction), а не потеря бюджетов
ADS_REDIS_MAXMEMORY=8gb

# IP клиента: заголовок, которому доверяем. На проде (за Cloudflare) — CF-Connecting-IP.
# Пусто → первый адрес X-Forwarded-For, иначе REMOTE_ADDR
CLIENT_IP_HEADER=
# Гео-база DB-IP Lite City (страна и город зрителя по IP; IP Geolocation by DB-IP, CC BY 4.0).
# Скачать: python manage.py update_geoip, дальше раз в месяц — beat. Пусто → data/dbip-city-lite.mmdb
GEOIP_PATH=
